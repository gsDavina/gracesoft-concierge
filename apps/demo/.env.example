# apps/api base URL. The demo reads the demo business's published services, open dates
# and free times from it (never sends booking details), so its form follows the opening
# hours set in Admin. The API's CORS_ORIGINS must include this app's origin.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Which business's published hours the demo books against (seeded by `seed:dev`).
NEXT_PUBLIC_DEMO_BUSINESS_ID=dev-business-1
