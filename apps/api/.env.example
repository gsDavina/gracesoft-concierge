NODE_ENV=development
PORT=3000

# Browser origins allowed to call the API (comma-separated). Defaults to the local
# admin-owner, admin-kiosk and demo dev servers; set it to the deployed URLs in production.
# CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Postgres connection string. Point at a local Postgres for dev; Railway provisions this
# in each deployed environment.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gracesoft_concierge?schema=public"

# DEV ONLY — stand-in for real per-business keys until a secrets manager is wired in.
# JSON map of { "<Business.encryptionKeyId>": "<base64 32-byte key>" }.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GRACESOFT_DEV_ENCRYPTION_KEYS='{"dev-business-key-1":"REPLACE_WITH_BASE64_32_BYTE_KEY"}'

# Meta WhatsApp Cloud API — required once the WhatsApp webhook (Phase 1) is wired in.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Telegram Bot API (Phase 4). Get a bot token from @BotFather in Telegram; generate a
# webhook secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without TELEGRAM_BOT_TOKEN, replies are logged instead of sent — see
# modules/telegram/telegramClient.ts's LoggingTelegramClient. TELEGRAM_BUSINESS_ID is
# which business this bot instance serves (one bot per business).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BUSINESS_ID=

# Anthropic API key — powers the Phase 1 onboarding wizard's LLM auto-draft step.
# Falls back to a heuristic (non-LLM) extractor if unset — see modules/onboarding/llmProvider.ts.
ANTHROPIC_API_KEY=
